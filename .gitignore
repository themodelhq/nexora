# ============================================================
# Nexora — Repository .gitignore
# Never commit secrets, private keys, or build artifacts.
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
build/
out/
.next/
coverage/

# --- Hardhat / Foundry ---
# Hardhat artifacts & cache (kept in git by design for contract verification
# is NOT recommended for private repos; ignore by default)
artifacts/
cache/
broadcast/
deployments/localhost/
deployments/sepolia/.deployed-addresses.json
!deployments/
typechain-types/

# Foundry
out/
broadcast/
forge-out/
packages/contracts/lib/forge-std/

# --- Environment / Secrets ---
# .env files are NEVER committed. Only .env.example is allowed.
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# --- Private keys / secrets ---
*.pem
*.key
*.p12
*.pfx
secrets/
keystore/
id_rsa*
*.gpg

# --- Test coverage ---
coverage/
lcov.info
*.lcov

# --- IDE / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
docker-data/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Misc ---
.tmp/
*.tmp
# ============================================================================
# NEXORA SECURITY RULES
# ============================================================================

# Environment files
.env
.env.*
!.env.example

# Private credentials
**/*private*key*
**/*private_key*
**/*mnemonic*
**/*seed*
**/*secret*

# Wallet/custody
**/.custody/

# Deployment/build output
**/artifacts/
**/cache/
**/coverage/
**/deployments/
**/build-info/
**/typechain-types/

# Credentials/certificates
*.pem
*.key
*.p12
*.pfx
*.keystore

# Runtime logs
*.log
