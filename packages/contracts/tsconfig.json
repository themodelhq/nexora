{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "mocha", "chai"]
  },
  "include": ["./src", "./test", "./scripts", "./tasks", "./hardhat.config.ts"],
  "exclude": ["node_modules", "dist"]
}
